{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch macOS app",
      "type": "npm",
      "script": "watch:mac",
      "isBackground": true,
      "problemMatcher": {
        "owner": "swift",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch:mac\\] Rebuilding",
          "endsPattern": "^\\[watch:mac\\] (App ready|Build/relaunch failed)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
